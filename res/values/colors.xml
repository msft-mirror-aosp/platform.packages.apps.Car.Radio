<resources>
    <!-- The color of the browse fragment list -->
    <color name="browse_fragment_list_color">@android:color/transparent</color>

    <!-- The fill color of the pause button. -->
    <color name="pause_button_fill_color">@android:color/black</color>

    <!-- The fill color of the play arrow. -->
    <color name="play_arrow_fill_color">@android:color/black</color>

    <!-- The fill color of the play off arrow. -->
    <color name="play_arrow_off_fill_color">@android:color/black</color>

    <!-- The color of the play/pause button -->
    <color name="playback_controls_play_button_color">@color/car_grey_50</color>

    <!-- The background ripple color for the playback button -->
    <color name="playback_button_ripple_background_color">#27ffffff</color>

    <!-- The background ripple fill color for the playback button -->
    <color name="playback_button_ripple_fill_color">?android:colorAccent</color>

    <!-- The fill color of the radio fm button. -->
    <color name="radio_fm_fill_color">#fafafa</color>
</resources>
